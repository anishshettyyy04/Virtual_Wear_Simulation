              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "USR001"]
            }
          }
        }
      ]
    },
    {
      "name": "Recommendations",
      "item": [
        {
          "name": "Generate Recommendations",
          "request": {
            "method": "POST",
            "header": [
