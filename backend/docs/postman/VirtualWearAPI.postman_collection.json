            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"USR001\",\n  \"limit\": 10,\n  \"forceRefresh\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/recommendations",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "recommendations"]
            }
