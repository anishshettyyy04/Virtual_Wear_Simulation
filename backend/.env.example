# Application Setup
APP_NAME="Virtual Wear Simulation API"
APP_VERSION="1.0.0"
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Server Setup
HOST=0.0.0.0
PORT=8000

# CORS Setup
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Storage & Upload Limits
MAX_UPLOAD_SIZE_MB=10
LOG_LEVEL=INFO

# AI Preprocessing Setup (Phase 1.2.2)
AI_INPUT_MAX_FILE_SIZE_MB=20
AI_INPUT_MAX_WIDTH=8192
AI_INPUT_MAX_HEIGHT=8192

AI_PREPROCESS_MAX_WIDTH=1024
AI_PREPROCESS_MAX_HEIGHT=1024
AI_PREPROCESS_OUTPUT_FORMAT=JPEG
AI_PREPROCESS_JPEG_QUALITY=95
AI_PROCESSED_DIR=data/processed

# AI Human Parser Setup (Phase 1.2.3B)
AI_HUMAN_PARSER_MODEL=mattmdjaga/segformer_b2_clothes
AI_HUMAN_PARSER_DEVICE=auto
AI_HUMAN_PARSER_OUTPUT_DIR=data/processed/parsing
AI_HUMAN_PARSER_PRECISION=fp32

# AI Pose Estimator Setup (Phase 1.2.4B)
AI_POSE_MODEL_DETECTOR=data/models/pose/yolox_l.onnx
AI_POSE_MODEL_ESTIMATOR=data/models/pose/dw-ll_ucoco_384.onnx
AI_POSE_DEVICE=auto
AI_POSE_CONFIDENCE_THRESHOLD=0.3
AI_POSE_DETECTION_THRESHOLD=0.4
AI_POSE_OUTPUT_DIR=data/processed/poses

