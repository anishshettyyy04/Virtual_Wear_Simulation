{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Recommendation API Contract",
  "type": "object",
  "required": ["success", "message", "data", "timestamp", "requestId"],
  "properties": {
    "success": { "type": "boolean", "const": true },
    "message": { "type": "string" },
    "timestamp": { "type": "string" },
    "requestId": { "type": "string" },
    "data": {
      "type": "object",
      "required": ["userId", "engineVersion", "strategy", "configVersion", "executionTimeMs", "recommendationsReturned", "recommendations"],
      "properties": {
        "userId": { "type": "string" },
        "engineVersion": { "type": "string" },
        "strategy": { "type": "string" },
        "configVersion": { "type": "string" },
        "executionTimeMs": { "type": "number" },
        "recommendationsReturned": { "type": "integer" },
        "recommendations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["productId", "name", "category", "brand", "price", "score", "reasons"],
            "properties": {
              "productId": { "type": "string" },
              "name": { "type": "string" },
              "score": { "type": "number" },
              "reasons": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    }
  }
}
