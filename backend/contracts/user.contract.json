{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "User API Contract",
  "type": "object",
  "required": ["success", "message", "data", "timestamp", "requestId"],
  "properties": {
    "success": { "type": "boolean", "const": true },
    "message": { "type": "string" },
    "timestamp": { "type": "string" },
    "requestId": { "type": "string" },
    "data": {
      "type": "object",
      "required": ["userId", "name", "gender", "ageGroup", "preferredCategories", "preferredColors", "preferredStyles", "preferredFit", "budgetRange", "favoriteSizes", "height", "weight", "bodyType"],
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "gender": { "type": "string" },
        "ageGroup": { "type": "string" },
        "preferredCategories": { "type": "array", "items": { "type": "string" } },
        "preferredColors": { "type": "array", "items": { "type": "string" } },
        "preferredStyles": { "type": "array", "items": { "type": "string" } },
        "preferredFit": { "type": "string" },
        "budgetRange": { "type": "object" },
        "favoriteSizes": { "type": "array", "items": { "type": "string" } },
        "height": { "type": "number" },
        "weight": { "type": "number" },
        "bodyType": { "type": "string" }
      }
    }
  }
}
